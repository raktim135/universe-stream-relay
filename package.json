{
  "name": "universe-stream-relay",
  "version": "0.3.0",
  "private": true,
  "description": "Relays Universe live-casino dealer video to our viewers: provider WebRTC -> MediaMTX -> WebRTC/LL-HLS, no re-encoding.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file=.env src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file=.env --watch src/index.js",
    "mediamtx": "mediamtx mediamtx.yml",
    "token": "node --env-file=.env scripts/sign-viewer-token.js",
    "watch-url": "node --env-file=.env scripts/get-watch-url.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "werift": "^0.25.2"
  }
}
