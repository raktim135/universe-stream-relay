# ---- HTTP server (our re-broadcast endpoint) ----
PORT=4010

# ---- Brand we log into to reach the Universe feed ----
# We authenticate against a brand that carries the Universe games (dream444 for this test).
# The brand issues a JWT that both the provider socket and the brand casino APIs accept.
BRAND_LOGIN_URL=https://dream444.win/app/users/userLogin
BRAND_CASINO_BASE=https://casino.dream444.win
BRAND_USERNAME=Dream3shk
BRAND_PASSWORD=Abcd12345

# Optional: paste a JWT here to skip auto-login (expires ~5h). Leave blank to auto-login.
UNIVERSE_TOKEN=

# ---- Provider (Universe) live-odds socket ----
UNIVERSE_SOCKET_URL=wss://casino.unityexch.com
UNIVERSE_SOCKET_PATH=/universecasino

# The provider domain uses GeoDNS (resolves only from India). On a server outside
# that region, DNS returns nothing but the servers still accept the connection, so
# pin the IP(s) here (comma-separated for failover). Refresh by resolving the host
# from an Indian network if the provider rotates IPs. Leave blank where DNS works.
UNIVERSE_SOCKET_IP=65.1.62.66,13.204.197.195

# ---- Tables to scrape: "eventId:Display Name", comma-separated ----
# Universe live games: 99.0030 Lucky 7 · 99.0018 Dragon Tiger · 99.0025 Andar Bahar
# 99.0010 20-20 Teen Patti · 99.0001 Baccarat · 99.0022 32 Cards · 99.0007 Poker
TABLES=99.0030:Lucky 7,99.0018:Dragon Tiger,99.0025:Andar Bahar,99.0010:Teen Patti

# CORS origin allowed to connect to our re-broadcast (the Next test page). * for local test.
CORS_ORIGIN=*
