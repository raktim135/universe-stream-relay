# ---- Environment ----
# production = refuses to start without VIEWER_TOKEN_SECRET, ADMIN_PASSWORD and
# public MediaMTX URLs; secure cookies; embedding limited to your sites.
# Anything else (or empty) = dev: same features, only warnings.
NODE_ENV=

# ---- HTTP server (our API + /watch player + /admin) ----
PORT=4010
# CORS origin allowed to call /api/video. * for local test.
CORS_ORIGIN=*
# Where SQLite files live (stats, settings, IP database).
DATA_DIR=data

# ---- Brand login (to reach the Universe video) ----
BRAND_LOGIN_URL=https://dream444.win/app/users/userLogin
BRAND_CASINO_BASE=https://casino.dream444.win
BRAND_USERNAME=Dream3shk
BRAND_PASSWORD=Abcd12345
# Optional pre-supplied JWT (skips auto-login until it expires). Blank = auto-login.
UNIVERSE_TOKEN=

# ---- MediaMTX ----
# How this app reaches MediaMTX on the same box.
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_WHIP_URL=http://127.0.0.1:8889
# How viewers' browsers reach MediaMTX. Production: via nginx, e.g.
#   https://stream.example.com/webrtc and https://stream.example.com/hls (see deploy/nginx.conf)
MEDIAMTX_PUBLIC_WEBRTC_URL=http://localhost:8889
MEDIAMTX_PUBLIC_HLS_URL=http://localhost:8888

# ---- Relay ----
# Release a table this long after its last viewer leaves (ms).
RELAY_IDLE_MS=30000
# Tables kept live with no viewers, comma-separated (e.g. 99.0030,99.0018). Blank = on demand only.
PREWARM_TABLES=

# Testing only: use pre-obtained watch URLs instead of calling the brand (for when
# the server IP is blocked, "viewer_ip_blocked"). Generate on a non-blocked machine
# with `npm run watch-url -- 99.0030`, paste below, restart. Space-separated
# "eventId=url" pairs. URLs are short-lived. Leave blank in normal operation.
TABLE_WATCH_URLS=

# ---- Viewer access ----
# Shared with our platform backend, which signs a token per viewer (src/viewerToken.js).
# Required in production (32+ chars, e.g. `openssl rand -hex 32`). Blank in dev = open access.
VIEWER_TOKEN_SECRET=
# true = tokens must carry the viewer's IP and only work from it (platform must sign with the IP).
VIEWER_TOKEN_BIND_IP=false

# ---- Admin dashboard (/admin) ----
ADMIN_USERNAME=admin
# Required in production (12+ chars). Blank = dashboard and admin API disabled.
ADMIN_PASSWORD=
# Optional: Bearer token for scripts calling /admin/api without logging in.
ADMIN_API_TOKEN=
ADMIN_SESSION_HOURS=12

# ---- Alerts ----
# Telegram alerts for suspicious viewers and auto actions. Both blank = off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Monitoring ----
# How often viewer connections are checked (ms).
MONITOR_POLL_MS=5000
# Days of sessions, actions and bandwidth history to keep.
RETENTION_DAYS=15
# Day boundaries for the bandwidth report.
STATS_TIMEZONE=Asia/Kolkata
# Country / hosting-provider lookups from DB-IP Lite (downloads ~12 MB monthly).
GEOIP_ENABLED=true

# First-boot defaults; change them later in the dashboard (Settings), which then wins.
# Sites allowed to embed /watch, comma-separated (example.com also allows its subdomains).
ALLOWED_EMBED_DOMAINS=
MAX_CONNECTIONS_PER_IP=4

# ---- Diagnostics ----
# Source-stream stats log interval (ms). 0 = off.
PROBE_INTERVAL_MS=60000
